# Copy to .env (never commit .env). Replay mode needs none of these.
SKYOPS_MODE=replay            # replay | record | live
SKYOPS_PROVIDER=anthropic     # anthropic | openai | ollama
# SKYOPS_MODEL=               # defaults per provider are in skyops/settings.py
SKYOPS_MAX_USD_PER_RUN=0.50   # the spend guard refuses any live call that could cross this
SKYOPS_PRICE_PROFILE=example  # a profile name in config/prices.toml
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_HOST=http://localhost:11434
